APP_NAME="Eventi Locali"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
TRUSTED_PROXIES=127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
