FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --prefer-dist --no-scripts --optimize-autoloader
FROM php:8.3-fpm-alpine
RUN apk add --no-cache icu-dev libpq-dev oniguruma-dev libzip-dev && docker-php-ext-install intl mbstring opcache pdo_pgsql zip && apk add --no-cache --virtual .build-deps $PHPIZE_DEPS && pecl install redis && docker-php-ext-enable redis && apk del .build-deps
WORKDIR /var/www/html
COPY --from=vendor /app/vendor ./vendor
COPY . .
RUN mkdir -p storage/app/public storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache && chown -R www-data:www-data storage bootstrap/cache
USER www-data
CMD ["php-fpm"]