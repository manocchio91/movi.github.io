{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          { "file_path": "/var/lib/docker/containers/*/*.log", "log_group_name": "/movi/ENVIRONMENT/docker", "log_stream_name": "{instance_id}", "retention_in_days": 14 }
        ]
      }
    }
  },
  "metrics": {
    "append_dimensions": { "InstanceId": "${aws:InstanceId}" },
    "metrics_collected": { "disk": { "measurement": ["used_percent"], "resources": ["/"] }, "mem": { "measurement": ["mem_used_percent"] } }
  }
}
