APP_NAME=MòVi Staging
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://STAGING_API_DOMAIN
FRONTEND_URL=https://STAGING_FRONTEND_DOMAIN
VITE_API_BASE_URL=https://STAGING_API_DOMAIN/api/v1
FLUTTER_API_BASE_URL=https://STAGING_API_DOMAIN/api/v1
TRUSTED_PROXIES=STAGING_PROXY_CIDR_OR_IP
CORS_ALLOWED_ORIGINS=https://STAGING_FRONTEND_DOMAIN
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DAILY_DAYS=14
DB_CONNECTION=pgsql
DB_HOST=RDS_PRIVATE_ENDPOINT
DB_PORT=5432
DB_DATABASE=eventi_staging
DB_USERNAME=eventi_staging
DB_PASSWORD=CHANGE_ME
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120
SANCTUM_STATEFUL_DOMAINS=STAGING_FRONTEND_DOMAIN
MAIL_MAILER=smtp
MAIL_HOST=STAGING_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=STAGING_FROM_ADDRESS
MAIL_FROM_NAME=MòVi Staging
FILESYSTEM_DISK=s3
PUBLIC_FILESYSTEM_DISK=s3
AWS_DEFAULT_REGION=eu-south-1
AWS_BUCKET=MOVI_STAGING_BUCKET
AWS_URL=https://MOVI_STAGING_BUCKET.s3.eu-south-1.amazonaws.com
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_BACKUP_PREFIX=database/staging
AWS_BACKUP_RETENTION_DAYS=14
BIND_ADDRESS=127.0.0.1
BACKEND_IMAGE=ghcr.io/owner/movi-backend:sha
FRONTEND_IMAGE=ghcr.io/owner/movi-frontend:sha
BACKEND_PORT=8080
FRONTEND_PORT=8081
BETA_ADMIN_EMAIL=admin-beta@example.test
BETA_ADMIN_PASSWORD=
BETA_ORGANIZER_EMAIL=organizer-beta@example.test
BETA_ORGANIZER_PASSWORD=
BETA_CUSTOMER_EMAIL=customer-beta@example.test
BETA_CUSTOMER_PASSWORD=

AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
AI_ENDPOINT=
AI_TIMEOUT=5

MENU_IMPORT_MAX_KB=5120
PREORDER_EDIT_DEADLINE_MINUTES=120
